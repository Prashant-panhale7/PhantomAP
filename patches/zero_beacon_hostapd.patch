--- a/src/ap/ieee802_11.c
+++ b/src/ap/ieee802_11.c
@@
 int ieee802_11_mgmt(struct hostapd_data *hapd, u8 *buf, size_t len, struct ieee802_11_elems *elems)
 {
 	struct ieee802_11_mgmt *mgmt = (struct ieee802_11_mgmt *) buf;
+	if (mgmt->frame_type == WLAN_FC_TYPE_MGMT &&
+	    mgmt->frame_sub_type == WLAN_FC_STYPE_PROBE_REQ &&
